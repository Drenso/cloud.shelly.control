[
  {
    "type": "group",
    "label": {
      "en": "Occupancy"
    },
    "children": [
      {
        "id": "occupancy_enabled",
        "type": "checkbox",
        "label": {
          "en": "Enable occupancy detection"
        },
        "hint": {
          "en": "When disabled the occupancy alarm capability will be removed."
        },
        "value": true
      },
      {
        "id": "occupied_threshold",
        "type": "number",
        "label": {
          "en": "Occupancy threshold"
        },
        "hint": {
          "en": "From which distance the occupancy alarm will be triggered."
        },
        "units": {
          "en": "mm"
        },
        "min": 200,
        "max": 5000,
        "step": 1,
        "value": 1000
      },
      {
        "id": "occupancy_hysteresis",
        "type": "number",
        "label": {
          "en": "Hysteresis"
        },
        "hint": {
          "en": "Hysteresis prevents occupancy from rapidly switching on and off by requiring the sensor value to move a configurable amount past the threshold before the state changes back."
        },
        "units": {
          "en": "mm"
        },
        "min": 10,
        "max": 500,
        "step": 1,
        "value": 100
      }
    ]
  }
]
