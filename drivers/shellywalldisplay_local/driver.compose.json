{
  "$extends": ["local"],
  "name": {
    "en": "Wall Display - LAN"
  },
  "class": "other",
  "capabilities": [
    "onoff",
    "measure_luminance",
    "volume_set",
    "speaker_playing",
    "speaker_track",
    "speaker_next",
    "speaker_prev",
    "speaker_stop",
    "button.screen_on",
    "button.screen_off",
    "measure_temperature",
    "measure_humidity"
  ],
  "images": {
    "xlarge": "/assets/drivers/shellywalldisplay/images/xlarge.png",
    "large": "/assets/drivers/shellywalldisplay/images/large.png",
    "small": "/assets/drivers/shellywalldisplay/images/small.png"
  },
  "pair": [
    {
      "$template": "wall_display_address",
      "id": "wall_display_address"
    },
    {
      "id": "authenticate_devices",
      "template": "loading",
      "options": {
        "text": "pair.loading_devices"
      }
    },
    {
      "$template": "device_credentials",
      "id": "device_password"
    },
    {
      "$template": "add_subdevices",
      "id": "add_subdevices"
    }
  ],
  "repair": [
    {
      "$template": "wall_display_address",
      "id": "wall_display_address"
    },
    {
      "$template": "repair",
      "id": "repair"
    }
  ]
}
