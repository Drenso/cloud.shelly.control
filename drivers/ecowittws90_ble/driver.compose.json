{
  "$extends": ["ble"],
  "name": {
    "en": "Ecowitt WS90 Weather Station - BLE"
  },
  "class": "sensor",
  "capabilities": [
    "measure_battery",
    "measure_temperature",
    "measure_temperature.dew_point",
    "measure_pressure",
    "measure_humidity",
    "measure_luminance",
    "measure_wind_strength",
    "measure_wind_angle",
    "measure_gust_strength",
    "measure_ultraviolet",
    "measure_voltage.capacitor",
    "alarm_rain",
    "measure_rain"
  ],
  "capabilitiesOptions": {
    "measure_temperature.dew_point": {
      "title": {
        "en": "Dew point"
      }
    },
    "measure_voltage.capacitor": {
      "title": {
        "en": "Capacitor voltage"
      }
    }
  },
  "energy": {
    "batteries": ["AA", "AA"]
  },
  "images": {
    "small": "/assets/drivers/ecowittws90/images/small.png",
    "large": "/assets/drivers/ecowittws90/images/large.png",
    "xlarge": "/assets/drivers/ecowittws90/images/xlarge.png"
  },
  "learnmode": {
    "image": "{{driverAssetsPath}}/learnmode.svg",
    "instruction": {
      "en": "When powered on the device should be detected automatically without a button press."
    }
  }
}
