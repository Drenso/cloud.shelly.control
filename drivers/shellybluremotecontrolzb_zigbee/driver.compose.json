{
  "$extends": ["zigbee"],
  "name": {
    "en": "BLU Remote Control ZB - Zigbee"
  },
  "class": "remote",
  "capabilities": ["measure_battery", "hidden.blu_remote_control"],
  "energy": {
    "batteries": ["AAA", "AAA"]
  },
  "zigbee": {
    "manufacturerName": "Shelly",
    "productId": ["BLU Remote Control ZB"],
    "endpoints": {
      "1": {
        "clusters": [0, 1, 6, 8],
        "bindings": [6, 8]
      }
    },
    "learnmode": {
      "image": "{{driverAssetsPath}}/learnmode.svg",
      "instruction": {
        "en": "Press one of the ring buttons five times to initialize Zigbee pairing. The LEDs will display a running animation."
      }
    }
  },
  "images": {
    "small": "/assets/drivers/shellybluremotecontrolzb/images/small.png",
    "large": "/assets/drivers/shellybluremotecontrolzb/images/large.png",
    "xlarge": "/assets/drivers/shellybluremotecontrolzb/images/xlarge.png"
  }
}
