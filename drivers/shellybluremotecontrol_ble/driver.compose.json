{
  "platforms": ["local"],
  "connectivity": ["ble"],
  "name": {
    "en": "BLU Remote Control"
  },
  "class": "remote",
  "capabilities": ["measure_battery"],
  "images": {
    "small": "/assets/drivers/shellybluremotecontrol/images/small.png",
    "large": "/assets/drivers/shellybluremotecontrol/images/large.png",
    "xlarge": "/assets/drivers/shellybluremotecontrol/images/xlarge.png"
  },
  "learnmode": {
    "image": "./assets/learnmode/floodsg4.svg",
    "instruction": {
      "en": "Press any button on the device four times. The LEDs will start flashing from left to right."
    }
  },
  "pair": [
    {
      "id": "ble_information",
      "$template": "ble_information",
      "navigation": { "next": "pair_instructions" }
    },
    {
      "id": "pair_instructions",
      "$template": "pair_instructions",
      "navigation": { "next": "list_my_devices" }
    },
    {
      "id": "list_my_devices",
      "template": "list_devices",
      "navigation": { "next": "add_my_devices" }
    },
    {
      "id": "add_my_devices",
      "template": "add_devices"
    }
  ]
}
