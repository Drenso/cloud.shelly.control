  "capabilities": ["alarm_open", "measure_rotation", "measure_battery"],
  "energy": {
    "batteries": ["CR2032"]
  },
  "images": {
    "small": "/assets/drivers/shellybludoorwindowoutdoorzb/images/small.png",
