{
  "name": "cloud.shelly.control",
  "version": "1.0.0",
  "main": "app.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "lint": "eslint",
    "fix": "eslint --fix",
    "locales-export": "homey-translation-helper extract -l all",
    "locales-import": "homey-translation-helper import -l all",
    "validate": "homey app validate --level=verified",
    "prettier": "prettier . --write",
    "prettier-check": "prettier . --check",
    "interview-rpc": "tsx .interview.ts",
    "update-flow-driver-filters": "tsx .fixFlows.ts"
  },
  "dependencies": {
    "@athombv/data-types": "1.2.2",
    "@drenso/homey-log": "10.5500.0",
    "@drenso/homey-zigbee-library": "2.3.0",
    "color-convert": "3.1.3",
    "homey-zigbeedriver": "2.2.17",
    "homey-zwavedriver": "2.2.3",
    "mitt": "3.0.1",
    "semver": "7.8.1",
    "source-map-support": "0.5.21",
    "undici": "8.3.0",
    "ws": "8.20.1",
    "zigbee-clusters": "3.1.3"
  },
  "devDependencies": {
    "@drenso/eslint-config-homey-mts": "1.2.0",
    "@drenso/homey-translation-helper": "2.5.0",
    "@drenso/prettier-config-homey-mts": "1.2.0",
    "@tsconfig/node20": "20.1.9",
    "@types/homey": "npm:homey-apps-sdk-v3-types@0.3.6",
    "@types/node": "24.11.0",
    "@types/semver": "7.7.1",
    "@types/source-map-support": "0.5.10",
    "@types/ws": "8.18.1",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.5",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  }
}
