{
  "type": "group",
  "label": {
    "en": "Presence Sensor - LED Configuration"
  },
  "children": [
    {
      "id": "Presence:leds.brightness",
      "type": "number",
      "label": {
        "en": "Maximum Brightness"
      },
      "value": 20,
      "min": 0,
      "max": 100,
      "units": "%"
    },
    {
      "type": "group",
      "label": "Night Mode",
      "children": [
        {
          "id": "Presence:leds.night_mode.enable",
          "type": "checkbox",
          "label": {
            "en": "Enabled"
          },
          "value": false
        },
        {
          "id": "Presence:leds.night_mode.brightness",
          "type": "number",
          "label": {
            "en": "Brightness"
          },
          "value": 100,
          "min": 0,
          "max": 100,
          "units": "%"
        },
        {
          "id": "Presence:leds.night_mode.active_between.start",
          "type": "text",
          "label": {
            "en": "Start Time"
          },
          "value": "00:00",
          "pattern": "^(?:(?:2[0-3])|(?:[01]?[0-9]))(?::[0-5][0-9])?$",
          "hint": {
            "en": "In 24 hour format (00:00 - 23:59)."
          }
        },
        {
          "id": "Presence:leds.night_mode.active_between.end",
          "type": "text",
          "label": {
            "en": "End Time"
          },
          "value": "23:59",
          "pattern": "^(?:(?:2[0-3])|(?:[01]?[0-9]))(?::[0-5][0-9])?$",
          "hint": {
            "en": "In 24 hour format (00:00 - 23:59)."
          }
        }
      ]
    }
  ]
}
