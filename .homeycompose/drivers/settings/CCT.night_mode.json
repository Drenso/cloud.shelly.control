{
  "type": "group",
  "label": "CCT - Night Mode",
  "children": [
    {
      "id": "CCT:night_mode.enable",
      "type": "checkbox",
      "label": {
        "en": "Enabled"
      },
      "value": false
    },
    {
      "id": "CCT:night_mode.brightness_enabled",
      "type": "checkbox",
      "label": {
        "en": "Override brightness"
      },
      "value": true
    },
    {
      "id": "CCT:night_mode.brightness",
      "type": "number",
      "label": {
        "en": "Brightness"
      },
      "value": 100,
      "min": 0,
      "max": 100,
      "units": "%"
    },
    {
      "id": "CCT:night_mode.ct_enabled",
      "type": "checkbox",
      "label": {
        "en": "Override color temperature"
      },
      "value": true
    },
    {
      "id": "CCT:night_mode.ct",
      "type": "number",
      "label": {
        "en": "Color temperature"
      },
      "value": 4600,
      "min": 2700,
      "max": 6500,
      "units": "K"
    },
    {
      "id": "CCT:night_mode.active_between.start",
      "type": "text",
      "label": {
        "en": "Start Time"
      },
      "value": "00:00",
      "pattern": "^(?:(?:2[0-3])|(?:[01]?[0-9]))(?::[0-5][0-9])?$",
      "hint": {
        "en": "In 24 hour format (00:00 - 23:59)."
      }
    },
    {
      "id": "CCT:night_mode.active_between.end",
      "type": "text",
      "label": {
        "en": "End Time"
      },
      "value": "23:59",
      "pattern": "^(?:(?:2[0-3])|(?:[01]?[0-9]))(?::[0-5][0-9])?$",
      "hint": {
        "en": "In 24 hour format (00:00 - 23:59)."
      }
    }
  ]
}
